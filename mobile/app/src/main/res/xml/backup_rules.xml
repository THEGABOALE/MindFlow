<?xml version="1.0" encoding="utf-8"?><!--
   Respaldo automático en Android 11 o menos (desde Android 12 se usa
   data_extraction_rules.xml).

   La sesión no se respalda: está cifrada con una clave del Keystore que no
   viaja con el respaldo, así que en otro teléfono no se podría leer.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="nova_session.xml" />
</full-backup-content>
