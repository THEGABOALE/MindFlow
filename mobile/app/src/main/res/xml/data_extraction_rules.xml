<?xml version="1.0" encoding="utf-8"?><!--
   Respaldo en la nube y traspaso a un teléfono nuevo, desde Android 12.

   La sesión no se copia en ninguno de los dos: está cifrada con una clave del
   Keystore que no viaja, así que en el otro teléfono no se podría leer y la
   app se cerraba al abrir. Ahí la persona simplemente vuelve a iniciar sesión.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nova_session.xml" />
        <!-- La caché y los resultados pendientes son datos de menores: no se respaldan. -->
        <exclude domain="database" path="nova.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nova_session.xml" />
        <!-- La caché y los resultados pendientes son datos de menores: no se respaldan. -->
        <exclude domain="database" path="nova.db" />
    </device-transfer>
</data-extraction-rules>
