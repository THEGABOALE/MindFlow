PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindflow_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# OAuth Client ID (tipo "Web application") de Google Cloud Console, usado para
# verificar los id_token que manda la app Android al loguear con Google.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Secreto para firmar los JWT de sesión. Cambiar por un valor largo y aleatorio
# en producción (nunca usar el valor de desarrollo).
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d