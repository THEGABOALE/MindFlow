PORT=3000
NODE_ENV=development

# Produccion (Neon, Railway): con DATABASE_URL definida se ignoran las 5 de abajo.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mindflow_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Client ID de Google Cloud Console, para verificar el login con Google
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# OBLIGATORIA en produccion: si NODE_ENV=production y falta, el server no arranca.
# En desarrollo, si se omite, usa un secreto de prueba (con warning en consola).
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
